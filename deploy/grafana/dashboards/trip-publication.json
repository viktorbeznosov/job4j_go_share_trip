  "panels": [
    {
      "title": "Publish rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sharetrip_trip_publish_total[5m]))",
          "legendFormat": "publish",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Publish error rate",
